# Etapa 1: Compilación de Frontend
FROM node:20-bookworm-slim AS builder

WORKDIR /app
COPY console-web/package*.json ./
RUN npm ci

COPY console-web/ ./
RUN npm run build

# Etapa 2: Servidor Web Nginx ligero y endurecido
FROM nginx:1.27-alpine-slim

# openssl para generar el par autofirmado cuando no se montan certificados
RUN apk add --no-cache openssl

# Copiar configuración de proxy y TLS de Nginx
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Generar certificado autofirmado si no hay uno montado (evita que nginx no arranque)
COPY deploy/web-entrypoint.sh /docker-entrypoint.d/10-certs.sh
RUN chmod +x /docker-entrypoint.d/10-certs.sh

# Copiar artefactos estáticos compilados
COPY --from=builder /app/dist /usr/share/nginx/html

# Crear directorio para certificados TLS
RUN mkdir -p /etc/nginx/certs && \
    chmod 700 /etc/nginx/certs

EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
