From: Agente-Cliente <cercano-dev@local>
Subject: [PATCH] feat(client): F2-05 propagacion de trace_id en eventos de auditoria del cliente
Date: 2026-11-06
Component: vendor/client
Task: F2-05

Propaga el trace_id (conn_audit_ref) en los eventos de conexion y transferencia de archivos
del cliente hacia los endpoints de auditoria de cercano-api.

---
diff --git a/vendor/client/src/server/connection.rs b/vendor/client/src/server/connection.rs
--- a/vendor/client/src/server/connection.rs
+++ b/vendor/client/src/server/connection.rs
@@ -1568,6 +1568,9 @@ impl Connection {
         v["uuid"] = json!(crate::encode64(hbb_common::get_uuid()));
         v["conn_id"] = json!(self.inner.id);
         v["session_id"] = json!(self.lr.session_id);
+        if let Some(trace_id) = self.conn_audit_ref() {
+            v["trace_id"] = json!(trace_id);
+        }
         // Unique per record; the api server dedups retried posts by it.
         v["nonce"] = json!(uuid::Uuid::new_v4().to_string());
         allow_err!(self.tx_post_seq.send((url, v)));
@@ -1615,6 +1618,7 @@ impl Connection {
             "uuid":json!(crate::encode64(hbb_common::get_uuid())),
             "peer_id":json!(self.lr.my_id),
             "conn_id":json!(self.inner.id()),
+            "trace_id": self.conn_audit_ref().map(str::to_owned),
             "type": r#type as i8,
             "path":path,
             "is_file":is_file,
