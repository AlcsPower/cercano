         });
         tokio::spawn(async move {
+            if let Some(hash_path) = hash_path {
+                // shortcut: only single-file transfers under 512 MiB carry a content hash
+                // computed over the local file at emission time, not over bytes in transit;
+                // multi-file batches or files exceeding 512 MiB skip hash calculation to avoid
+                // delaying or losing the audit event.
+                const MAX_AUDIT_HASH_BYTES: u64 = 512 * 1024 * 1024;
+                if total_bytes <= MAX_AUDIT_HASH_BYTES {
+                    if let Ok(Some(sha256)) = tokio::task::spawn_blocking(move || {
+                        let mut file = std::fs::File::open(hash_path).ok()?;
+                        let metadata = file.metadata().ok()?;
+                        if metadata.len() > MAX_AUDIT_HASH_BYTES {
+                            return None;
+                        }
+                        crate::update_hash::sha256_reader_hex(&mut file).ok()
+                    })
+                    .await
+                    {
+                        v["sha256"] = json!(sha256);
+                    }
+                }
+            }
             allow_err!(Self::post_audit_async(url, v).await);
         });
     }
 
+    /// Local path of the audited file when the event covers exactly one file.
+    fn audit_file_path(base: &str, files: &[(String, i64)]) -> Option<PathBuf> {
+        if files.len() != 1 {
+            return None;
+        }
+        let name = files[0].0.trim();
+        let candidate = if name.is_empty() {
+            PathBuf::from(base)
+        } else if Path::new(name).is_absolute() {
+            PathBuf::from(name)
+        } else {
+            Path::new(base).join(name)
+        };
+        candidate.is_file().then_some(candidate)
+    }
