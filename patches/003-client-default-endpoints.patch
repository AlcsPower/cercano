Task: F1-08

Configuracion por defecto de endpoints de red y telemetria:
- Rendezvous/ID Server: 127.0.0.1:21116
- Relay Server: 127.0.0.1:21117
- API Server: http://127.0.0.1:21114
- Latido de telemetria hacia POST /api/devices/heartbeat enviando id, os, hostname y version

---
diff --git a/vendor/client/src/client.rs b/vendor/client/src/client.rs
index 597dc86..9b224e3 100644
--- a/vendor/client/src/client.rs
+++ b/vendor/client/src/client.rs
@@ -1859,6 +1859,10 @@ impl Client {
         ipv4: bool,
     ) -> ResultType<Stream> {
         // The proxy's address family does not constrain the relay target.
+        let mut relay_server = relay_server;
+        if relay_server.is_empty() {
+            relay_server = "127.0.0.1:21117".to_string();
+        }
         let relay_server = check_port(relay_server, RELAY_PORT);
         let use_ws_proxy = Config::is_proxy() && is_ws_endpoint(&check_ws(&relay_server));
         let mut conn = connect_tcp(
