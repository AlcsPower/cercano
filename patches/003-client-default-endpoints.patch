                 if !conns.is_empty() {
                     v["conns"] = json!(conns);
                 }
@@ -289,7 +294,7 @@ fn heartbeat_url() -> String {
     if url.is_empty() || crate::is_public(&url) {
         return "".to_owned();
     }
-    format!("{}/api/heartbeat", url)
+    format!("{}/api/devices/heartbeat", url)
 }
 
