-        conversation = ChatConversation.fromJson(parsed);
+        final next = ChatConversation.fromJson(parsed);
+        technicianNotice =
+            reassignmentNotice(conversation, next, branding.organizationName) ??
+                technicianNotice;
+        conversation = next;
         notifyListeners();
       }
     } catch (_) {}
